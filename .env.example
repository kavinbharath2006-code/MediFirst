# MediFirst — repo-root environment (single source of truth)
# Copy to .env (git-ignored) and fill in real values:  Copy-Item .env.example .env
# backend/server.js loads only this file — it is the single source of truth.

# ─── Server ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB (Atlas) ────────────────────────────────────────────────
# Use the explicit host list: mongodb+srv:// requires a DNS SRV query, which
# some networks refuse (Node fails with "querySrv ECONNREFUSED") while plain
# A-record lookups for the same hosts work fine. Find your shard hostnames in
# the Atlas connect dialog ("Connect your application" -> I have an older driver).
MONGODB_URI=mongodb://<user>:<password>@<shard-00-00>.mongodb.net:27017,<shard-00-01>.mongodb.net:27017,<shard-00-02>.mongodb.net:27017/<db>?tls=true&replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority
# Tried automatically if the direct hosts above ever fail
MONGODB_URI_SRV=mongodb+srv://<user>:<password>@cluster0.<id>.mongodb.net/<db>
# Optional local server, uncomment to develop without Atlas
# MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/medifirst

# ─── Google Gemini ──────────────────────────────────────────────────
GEMINI_API_KEY=<your_gemini_api_key>
# gemini-1.5-flash is retired (404 on generateContent). If this model is ever
# retired too, the service fails over to gemini-flash-latest automatically.
GEMINI_MODEL=gemini-3-flash-preview
# Hard latency budget for the primary Gemini call. When it trips, curated
# static fallback steps are served (guidanceSource: "static-fallback").
GUIDANCE_TIMEOUT_MS=3500
GEMINI_MAX_OUTPUT_TOKENS=500

# ─── Google Maps ────────────────────────────────────────────────────
# Requires Billing enabled on the Cloud project; without it Geocoding returns
# REQUEST_DENIED and the API falls back to local/demo hospital data.
GOOGLE_MAPS_API_KEY=<your_google_maps_api_key>

# ─── RAG microservice ───────────────────────────────────────────────
RAG_SERVICE_URL=http://localhost:8000
RAG_TIMEOUT_MS=5000
RAG_REBUILD_TIMEOUT_MS=30000

# ─── Static assets ──────────────────────────────────────────────────
# Files in backend/assets are served at this path by the production server.
ASSET_BASE_URL=/assets

# ─── Frontend variables ─────────────────────────────────────────────
# react-scripts only reads frontend/.env — the root file is not visible to the
# browser bundle. Fill frontend/.env (also git-ignored) if you need to override
# the demo-mode behaviour:
#   REACT_APP_API_BASE=              empty = same origin, i.e. /api/...
#   REACT_APP_ASSET_BASE_URL=/assets
#   REACT_APP_DEMO_MODE=false
# (No provider keys belong here any more — the browser only talks to our own
#  backend, which holds the Gemini/Maps keys server-side.)
