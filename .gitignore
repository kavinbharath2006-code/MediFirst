chroma_db/
*.index
firstaid_meta.json

# ─── Tooling scratch dirs ───────────────────────────────────────────
.vercel/
.vercel-tmp/

# ─── Editors / OS ───────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
Desktop.ini
