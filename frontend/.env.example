# MediFirst frontend — browser variables
# Copy to frontend/.env (git-ignored) and restart `npm run dev`.
#
# react-scripts only reads .env files from the frontend folder, so these stay
# separate from the repo-root .env that the backend/RAG use. Anything here is
# compiled into the public JS bundle — never put a secret in a REACT_APP_* value
# that must stay private; fetch it from the backend instead.

# Same-origin by default: requests go to /api/... and the CRA dev proxy forwards
# them to http://localhost:5000 (see "proxy" in frontend/package.json). Set this
# only when the frontend and backend are deployed to different hosts.
REACT_APP_API_BASE=

# Files in backend/assets are served under this path (consumed by src/config.js).
REACT_APP_ASSET_BASE_URL=/assets

# All AI calls go through the backend (/api/guidance) — no provider keys are
# ever used in the browser. Set to true to force offline demo mode with canned
# fallback guidance (no backend required).
REACT_APP_DEMO_MODE=false

# Optional: enables the Google Maps embed preview on the Services page.
REACT_APP_GOOGLE_MAPS_API_KEY=<your_google_maps_api_key>
